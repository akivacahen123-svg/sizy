{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sizy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // כל בקשה עוברת קודם דרך ה-Worker, כך שכל האתר נעול מאחורי הסיסמה.
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true },
  // מגביל כמה ניתוחים מותר לכל משתמש בדקה (כל ניתוח עולה כסף על המפתח של גוגל).
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } }],
  "vars": {
    // "true": כל אחד נכנס בלי סיסמה, וכל משתמש עובד עם מפתח Gemini אישי משלו (בלי עלות לבעל האתר).
    // "false": נדרשת סיסמה.
    "PUBLIC_ACCESS": "true",
    // מזהה לקוח של Google OAuth (לא סוד). אם מוגדר, נכנסים עם חשבון Google.
    "GOOGLE_CLIENT_ID": "",
    // ריק: ברירת המחדל gemini-flash-latest עם גיבוי ל-gemini-2.5-flash.
    "GEMINI_MODEL": ""
  }
}
